# ─────────────────────────────────────────────────────────────
# FAA SWIM / Solace (used by swim_to_kafka.py). Fill from your FAA subscription.
# ─────────────────────────────────────────────────────────────
SCDS_HOST=tcps://ems2.swim.faa.gov:55443
SCDS_VPN=TFMS
SCDS_USERNAME=
SCDS_PASSWORD=
SCDS_QUEUE_FLIGHT=
SOLACE_TRUST_STORE=

# ─────────────────────────────────────────────────────────────
# Postgres (used by kafka_to_postgres.py, compose, and run.sh)
# ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aeroflux
POSTGRES_USER=aeroflux
POSTGRES_PASSWORD=aeroflux-db

# ─────────────────────────────────────────────────────────────
# Kafka
# ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=swim.raw.flight
KAFKA_CONSUMER_GROUP=aeroflux-postgres-writer

# Leave DSN blank — run.sh derives it from POSTGRES_* above.
DSN=
