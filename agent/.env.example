# Copy to .env and fill in. See README.md for setup.

# Free, no credit card, from console.groq.com
GROQ_API_KEY=

# Optional: swap the model (default in agent.py is llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# The agent's OWN pgvector container (docker-compose.yml) -- port 5433, not
# 5432. 5432 is AeroFlux's own main Postgres (../compose.yaml); running both
# stacks side by side means the agent MUST use a different host port, or its
# connection silently hits the wrong database. Matches docker-compose.yml's
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB (all local-dev-only, not real
# secrets). tools.py/ingest.py fall back to this exact value if DATABASE_URL
# isn't set at all, but set it explicitly here too -- explicit beats implicit.
DATABASE_URL=postgresql://aeroflux:aeroflux_local_dev@localhost:5433/aeroflux_rag

# Set once you point AeroFlux's Analyst page at this agent (see
# AGENT_INTEGRATION.md) -- not needed to run the agent itself.
# AEROFLUX_AGENT_URL=http://localhost:8010/ask
